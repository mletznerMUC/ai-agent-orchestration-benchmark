{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/guard-git.mjs\"",
            "timeout": 10,
            "statusMessage": "Checking the command against the main-branch guard"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && npm run --silent cost",
            "timeout": 60,
            "statusMessage": "Updating COST_CONTROL.md"
          }
        ]
      }
    ]
  }
}
