<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AI Agent Orchestration · Benchmark 2026</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #ffffff;
    --bg-subtle: #f7f7f8;
    --bg-muted: #f0f0f2;
    --border: #e4e4e7;
    --border-strong: #d1d1d6;
    --text: #18181b;
    --text-secondary: #52525b;
    --text-muted: #a1a1aa;
    --accent: #2563eb;
    --accent-bg: #eff6ff;
    --accent-border: #bfdbfe;
    --green: #16a34a;
    --green-bg: #f0fdf4;
    --green-border: #bbf7d0;
    --yellow: #b45309;
    --yellow-bg: #fffbeb;
    --yellow-border: #fde68a;
    --red: #dc2626;
    --red-bg: #fef2f2;
    --red-border: #fecaca;
    --maestro: #2563eb;
    --strands: #7c3aed;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    background: var(--bg);
    color: var(--text);
    min-height: 100vh;
    font-size: 14px;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* Top bar */
  .topbar {
    border-bottom: 1px solid var(--border);
    padding: 12px 0;
    background: var(--bg);
  }

  .topbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .topbar-logo {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    font-weight: 500;
    color: var(--text-secondary);
    letter-spacing: -0.01em;
  }

  .topbar-meta {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    color: var(--text-muted);
  }

  /* Header */
  .header {
    padding: 64px 0 48px;
    border-bottom: 1px solid var(--border);
  }

  .category-tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    font-weight: 500;
    color: var(--accent);
    background: var(--accent-bg);
    border: 1px solid var(--accent-border);
    border-radius: 4px;
    padding: 3px 8px;
    margin-bottom: 20px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  h1 {
    font-size: clamp(1.75rem, 3.5vw, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.15;
    color: var(--text);
    margin-bottom: 16px;
    max-width: 700px;
  }

  .header-meta {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 40px;
    flex-wrap: wrap;
  }

  .subtitle {
    color: var(--text-secondary);
    font-size: 15px;
    line-height: 1.65;
    max-width: 560px;
  }

  .header-stats {
    display: flex;
    gap: 32px;
    flex-shrink: 0;
  }

  .stat {
    text-align: right;
  }

  .stat-num {
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--text);
    line-height: 1;
    margin-bottom: 2px;
  }

  .stat-label {
    font-size: 11px;
    color: var(--text-muted);
    font-family: 'JetBrains Mono', monospace;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  /* Section layout */
  .section {
    padding: 48px 0;
    border-bottom: 1px solid var(--border);
  }

  .section:last-of-type {
    border-bottom: none;
  }

  .section-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 24px;
    gap: 16px;
  }

  .section-title {
    font-size: 11px;
    font-family: 'JetBrains Mono', monospace;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    text-transform: uppercase;
  }

  .section-legend {
    display: flex;
    gap: 16px;
    align-items: center;
    flex-wrap: wrap;
  }

  .legend-item {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    color: var(--text-muted);
    font-family: 'JetBrains Mono', monospace;
  }

  .legend-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  /* Score overview */
  .score-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
  }

  .score-card {
    background: var(--bg);
    padding: 20px;
    position: relative;
  }

  .score-card.is-maestro {
    background: var(--accent-bg);
  }

  .score-card.is-top {
    background: var(--green-bg);
  }

  .score-tool {
    font-size: 13px;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 12px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .score-badge {
    font-family: 'JetBrains Mono', monospace;
    font-size: 9px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 2px 5px;
    border-radius: 3px;
  }

  .badge-ref {
    color: var(--accent);
    background: var(--accent-bg);
    border: 1px solid var(--accent-border);
  }

  .badge-top {
    color: var(--green);
    background: var(--green-bg);
    border: 1px solid var(--green-border);
  }

  .score-number {
    font-size: 36px;
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
    margin-bottom: 8px;
  }

  .is-maestro .score-number { color: var(--accent); }
  .is-top .score-number { color: var(--green); }
  .score-card .score-number { color: var(--text); }

  .score-bar-track {
    height: 3px;
    background: var(--border-strong);
    border-radius: 2px;
    overflow: hidden;
    margin-bottom: 6px;
  }

  .score-bar-fill {
    height: 100%;
    border-radius: 2px;
  }

  .is-maestro .score-bar-fill { background: var(--accent); }
  .is-top .score-bar-fill { background: var(--green); }
  .score-card .score-bar-fill { background: var(--text-secondary); }

  .score-descriptor {
    font-size: 10px;
    font-family: 'JetBrains Mono', monospace;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  /* Feature matrix */
  .matrix-wrap {
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: 8px;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    min-width: 1020px;
  }

  thead {
    background: var(--bg-subtle);
    border-bottom: 1px solid var(--border);
  }

  th {
    padding: 12px 16px;
    text-align: left;
    font-size: 11px;
    font-family: 'JetBrains Mono', monospace;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--text-secondary);
    white-space: nowrap;
  }

  th.feature-col {
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
    width: 200px;
  }

  th.maestro-col {
    background: var(--accent-bg);
    color: var(--accent);
    border-left: 1px solid var(--accent-border);
    border-right: 1px solid var(--accent-border);
  }

  td {
    padding: 12px 16px;
    border-bottom: 1px solid var(--border);
    vertical-align: middle;
  }

  tr:last-child td { border-bottom: none; }

  tr:hover td {
    background: var(--bg-subtle);
  }

  td.maestro-col {
    background: rgba(37, 99, 235, 0.03);
    border-left: 1px solid var(--accent-border);
    border-right: 1px solid var(--accent-border);
  }

  tr:hover td.maestro-col {
    background: rgba(37, 99, 235, 0.06);
  }

  .feature-name {
    font-size: 13px;
    font-weight: 500;
    color: var(--text);
    white-space: nowrap;
    display: block;
  }

  .feature-desc {
    font-size: 11px;
    color: var(--text-muted);
    font-family: 'JetBrains Mono', monospace;
    display: block;
    margin-top: 1px;
  }

  /* Status chips */
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 2px 8px;
    border-radius: 4px;
    font-size: 11px;
    font-family: 'JetBrains Mono', monospace;
    font-weight: 500;
    white-space: nowrap;
    border: 1px solid transparent;
  }

  .chip-yes {
    color: var(--green);
    background: var(--green-bg);
    border-color: var(--green-border);
  }

  .chip-partial {
    color: var(--yellow);
    background: var(--yellow-bg);
    border-color: var(--yellow-border);
  }

  .chip-no {
    color: var(--text-muted);
    background: var(--bg-muted);
    border-color: var(--border);
  }

  /* Pricing grid */
  .price-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 12px;
  }

  .price-card {
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
  }

  .price-card.is-featured {
    border-color: var(--accent-border);
  }

  .price-card-header {
    padding: 16px 18px 12px;
    border-bottom: 1px solid var(--border);
    background: var(--bg-subtle);
  }

  .is-featured .price-card-header {
    background: var(--accent-bg);
    border-bottom-color: var(--accent-border);
  }

  .price-tool {
    font-size: 14px;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 2px;
  }

  .is-featured .price-tool {
    color: var(--accent);
  }

  .price-type {
    font-size: 11px;
    color: var(--text-muted);
    font-family: 'JetBrains Mono', monospace;
  }

  .price-card-body {
    padding: 16px 18px;
  }

  .price-main {
    font-size: 24px;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--text);
    line-height: 1;
    margin-bottom: 4px;
  }

  .price-note {
    font-size: 11px;
    color: var(--text-muted);
    font-family: 'JetBrains Mono', monospace;
    margin-bottom: 14px;
  }

  .price-rows {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .price-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 6px 8px;
    border-radius: 4px;
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    font-size: 12px;
  }

  .price-row-label {
    color: var(--text-secondary);
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
  }

  .price-row-value {
    font-weight: 500;
    color: var(--text);
  }

  .price-row-value.is-free {
    color: var(--green);
  }

  .price-row-value.is-muted {
    color: var(--text-muted);
  }

  /* Verdict section */
  .verdict-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 12px;
  }

  .verdict-card {
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
    display: grid;
    gap: 12px;
  }

  .verdict-header {
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }

  .verdict-icon {
    width: 36px;
    height: 36px;
    border-radius: 6px;
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    flex-shrink: 0;
  }

  .verdict-title {
    font-size: 13px;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 2px;
    line-height: 1.3;
  }

  .verdict-subtitle {
    font-size: 11px;
    color: var(--text-muted);
    font-family: 'JetBrains Mono', monospace;
  }

  .verdict-body {
    font-size: 12px;
    color: var(--text-secondary);
    line-height: 1.65;
  }

  .verdict-tag {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    font-weight: 500;
    color: var(--accent);
    background: var(--accent-bg);
    border: 1px solid var(--accent-border);
    border-radius: 4px;
    padding: 2px 7px;
  }

  /* Comparison highlight row */
  .highlight-bar {
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 16px 20px;
    margin-bottom: 24px;
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .highlight-bar-label {
    font-size: 11px;
    font-family: 'JetBrains Mono', monospace;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-right: 4px;
  }

  .tool-tag {
    font-size: 11px;
    font-family: 'JetBrains Mono', monospace;
    font-weight: 500;
    padding: 3px 8px;
    border-radius: 4px;
    border: 1px solid var(--border);
    background: var(--bg);
    color: var(--text-secondary);
  }

  .tool-tag.is-maestro {
    color: var(--accent);
    background: var(--accent-bg);
    border-color: var(--accent-border);
  }

  /* Footer */
  footer {
    padding: 24px 0;
    border-top: 1px solid var(--border);
    margin-top: 48px;
  }

  .footer-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .footer-left, .footer-right {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    color: var(--text-muted);
  }

  .divider {
    height: 1px;
    background: var(--border);
    margin: 0;
  }

  @media (max-width: 768px) {
    h1 { font-size: 1.6rem; }
    .header-meta { flex-direction: column; gap: 24px; }
    .header-stats { justify-content: flex-start; }
    .stat { text-align: left; }
    .section-header { flex-direction: column; align-items: flex-start; }
    .footer-inner { flex-direction: column; }
    .footer-right { text-align: left; }
  }
</style>
</head>
<body>

<div class="topbar">
  <div class="topbar-inner">
    <span class="topbar-logo">agent-benchmark.dev</span>
    <span class="topbar-meta">Stand: Mai 2026</span>
  </div>
</div>

<div class="container">

  <div class="header">
    <div class="category-tag">Benchmark 2026</div>
    <h1>AI Agent Orchestration<br>Alternatives to Maestro</h1>
    <div class="header-meta">
      <p class="subtitle">Vergleich der führenden Tools zur Orchestrierung autonomer KI-Agents — von Desktop-Apps bis Enterprise-Frameworks. Alle Daten basieren auf öffentlicher Dokumentation und Eigentests.</p>
      <div class="header-stats">
        <div class="stat">
          <div class="stat-num">8</div>
          <div class="stat-label">Tools</div>
        </div>
        <div class="stat">
          <div class="stat-num">14</div>
          <div class="stat-label">Features</div>
        </div>
        <div class="stat">
          <div class="stat-num">2026</div>
          <div class="stat-label">Edition</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Score Overview -->
  <div class="section">
    <div class="section-header">
      <span class="section-title">Gesamtbewertung &nbsp;/ 100</span>
    </div>
    <div class="score-grid">
      <div class="score-card is-maestro">
        <div class="score-tool">Maestro <span class="score-badge badge-ref">Referenz</span></div>
        <div class="score-number">84</div>
        <div class="score-bar-track"><div class="score-bar-fill" style="width:84%"></div></div>
        <div class="score-descriptor">Desktop Orchestrator</div>
      </div>
      <div class="score-card is-top">
        <div class="score-tool">LangGraph <span class="score-badge badge-top">Best Overall</span></div>
        <div class="score-number">88</div>
        <div class="score-bar-track"><div class="score-bar-fill" style="width:88%"></div></div>
        <div class="score-descriptor">Code-First Framework</div>
      </div>
      <div class="score-card">
        <div class="score-tool">Strands Agents</div>
        <div class="score-number">86</div>
        <div class="score-bar-track"><div class="score-bar-fill" style="width:86%"></div></div>
        <div class="score-descriptor">AWS-Native SDK</div>
      </div>
      <div class="score-card">
        <div class="score-tool">CrewAI</div>
        <div class="score-number">82</div>
        <div class="score-bar-track"><div class="score-bar-fill" style="width:82%"></div></div>
        <div class="score-descriptor">Best Onboarding</div>
      </div>
      <div class="score-card">
        <div class="score-tool">n8n</div>
        <div class="score-number">79</div>
        <div class="score-bar-track"><div class="score-bar-fill" style="width:79%"></div></div>
        <div class="score-descriptor">Best No-Code</div>
      </div>
      <div class="score-card">
        <div class="score-tool">AutoGen</div>
        <div class="score-number">75</div>
        <div class="score-bar-track"><div class="score-bar-fill" style="width:75%"></div></div>
        <div class="score-descriptor">Enterprise (Microsoft)</div>
      </div>
      <div class="score-card">
        <div class="score-tool">Claude Squad</div>
        <div class="score-number">72</div>
        <div class="score-bar-track"><div class="score-bar-fill" style="width:72%"></div></div>
        <div class="score-descriptor">Lightweight CLI</div>
      </div>
      <div class="score-card">
        <div class="score-tool">OpenAI SDK</div>
        <div class="score-number">70</div>
        <div class="score-bar-track"><div class="score-bar-fill" style="width:70%"></div></div>
        <div class="score-descriptor">Fast Prototype</div>
      </div>
    </div>
  </div>

  <!-- Feature Matrix -->
  <div class="section">
    <div class="section-header">
      <span class="section-title">Feature-Matrix</span>
      <div class="section-legend">
        <div class="legend-item"><div class="legend-dot" style="background:var(--green)"></div>Vollständig</div>
        <div class="legend-item"><div class="legend-dot" style="background:var(--yellow)"></div>Teilweise / Beta</div>
        <div class="legend-item"><div class="legend-dot" style="background:var(--text-muted)"></div>Nicht vorhanden</div>
      </div>
    </div>
    <div class="matrix-wrap">
      <table>
        <thead>
          <tr>
            <th class="feature-col">Feature</th>
            <th class="maestro-col">Maestro</th>
            <th>LangGraph</th>
            <th>Strands</th>
            <th>CrewAI</th>
            <th>n8n</th>
            <th>Claude Squad</th>
            <th>AutoGen</th>
            <th>OpenAI SDK</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><span class="feature-name">Multi-Agent Parallel</span><span class="feature-desc">Gleichzeitige Ausführung</span></td>
            <td class="maestro-col"><span class="chip chip-yes">Vollständig</span></td>
            <td><span class="chip chip-yes">Vollständig</span></td>
            <td><span class="chip chip-yes">Swarm + A-as-T</span></td>
            <td><span class="chip chip-yes">Vollständig</span></td>
            <td><span class="chip chip-partial">Begrenzt</span></td>
            <td><span class="chip chip-yes">Vollständig</span></td>
            <td><span class="chip chip-yes">Vollständig</span></td>
            <td><span class="chip chip-partial">Beta</span></td>
          </tr>
          <tr>
            <td><span class="feature-name">Desktop GUI</span><span class="feature-desc">Native App / Dashboard</span></td>
            <td class="maestro-col"><span class="chip chip-yes">Vollständig</span></td>
            <td><span class="chip chip-no">Nein</span></td>
            <td><span class="chip chip-no">SDK only</span></td>
            <td><span class="chip chip-partial">Web Studio</span></td>
            <td><span class="chip chip-yes">Web App</span></td>
            <td><span class="chip chip-no">Terminal</span></td>
            <td><span class="chip chip-partial">Studio UI</span></td>
            <td><span class="chip chip-no">Nein</span></td>
          </tr>
          <tr>
            <td><span class="feature-name">Playbooks / Auto-Run</span><span class="feature-desc">Autonome Langzeit-Tasks</span></td>
            <td class="maestro-col"><span class="chip chip-yes">Vollständig</span></td>
            <td><span class="chip chip-yes">Workflows</span></td>
            <td><span class="chip chip-yes">Agent Loop</span></td>
            <td><span class="chip chip-partial">Flows</span></td>
            <td><span class="chip chip-yes">Vollständig</span></td>
            <td><span class="chip chip-no">Nein</span></td>
            <td><span class="chip chip-partial">Begrenzt</span></td>
            <td><span class="chip chip-no">Nein</span></td>
          </tr>
          <tr>
            <td><span class="feature-name">Mobile Remote Control</span><span class="feature-desc">Steuerung per Smartphone</span></td>
            <td class="maestro-col"><span class="chip chip-yes">QR + Tunnel</span></td>
            <td><span class="chip chip-no">Nein</span></td>
